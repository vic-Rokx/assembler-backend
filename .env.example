# Copy to .env (git-ignored). Settings already in the environment win over
# this file. Everything is optional; src/Settings.zig documents each one.
# Comments go on their own lines: a value runs to the end of its line.

# Where to listen. 0.0.0.0 in a container (the Dockerfile sets it).
# HOST=127.0.0.1
# PORT=8080

# The frontend's origin. Requests carry credentials, so CORS names it.
# ALLOWED_ORIGIN=http://localhost:5173

# Google sign-in is on when these three are set. SESSION_SECRET signs
# session cookies: 32 random bytes or more (openssl rand -hex 32).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SESSION_SECRET=

# Must be listed for the client in Google Cloud.
# OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback

# Behind HTTPS. SameSite=None (a frontend on another site) needs it.
# SECURE_COOKIES=1
# COOKIE_SAMESITE=lax

# Record each user who signs in. Without it nothing is stored, and the
# session names the Google account.
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/assembler

# Playground builds: how many at once, how many may wait, and how long one
# may take before its process group is killed.
# BUILD_THREADS=2
# BUILD_QUEUE=8
# BUILD_TIMEOUT_SECONDS=60

# POST /chat and POST /api/vertex call the model with these, the server's
# own credentials, for self-hosting. The hosted app's users bring their own
# keys, which stay in their browser and never reach this server.
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# VERTEX_PROJECT_ID=
# VERTEX_ACCESS_TOKEN=
# VERTEX_REGION=us-east5
